# Public https URL where MCP clients reach this server (behind your reverse proxy).
PUBLIC_URL=https://mcp.example.com

# Base URL of your Docmost instance.
DOCMOST_URL=https://docs.example.com
# Set to true only for a Docmost reachable over http on a trusted private network.
DOCMOST_ALLOW_INSECURE_HTTP=false

# Password for the bundled Postgres. Use a long random value.
POSTGRES_PASSWORD=

# Encrypts stored Docmost sessions and snapshots and signs cookies. At least 32 characters,
# for example the output of: openssl rand -hex 32
# Losing it signs every member out; leaking it together with the database
# exposes their Docmost sessions.
SECRET_KEY=
# During a key rotation: the old key, so existing sessions stay readable.
SECRET_KEY_PREVIOUS=

# Comma-separated emails allowed to sign in. Empty allows every Docmost user.
ALLOWED_EMAILS=

# Comma-separated space slugs or ids members may use through this server.
# Empty allows every space the member can see in Docmost.
ALLOWED_SPACES=

# When a member's Docmost session expires: "ask" them to sign in again (default),
# or "stored_password" to keep their password encrypted and sign in automatically.
RELOGIN_MODE=ask

# Days page snapshots (copies of page bodies taken before every change) are kept.
SNAPSHOT_RETENTION_DAYS=30
# Days audit log entries (who called which tool on which page) are kept.
AUDIT_RETENTION_DAYS=90
# Tool calls one member may make per minute, over all their clients.
TOOL_CALLS_PER_MINUTE=60

# Reverse proxies whose X-Forwarded-For header is trusted for rate limiting.
# The compose file publishes the port on 127.0.0.1 only and trusts every
# client by default ("*"). Set the proxy's address if you publish it elsewhere.
# FORWARDED_ALLOW_IPS=*

LOG_LEVEL=info
