# Public https URL where MCP clients reach this server (behind your reverse proxy).
PUBLIC_URL=https://mcp.example.com

# Base URL of your Docmost instance.
DOCMOST_URL=https://docs.example.com
# Set to true only for a Docmost reachable over http on a trusted private network.
DOCMOST_ALLOW_INSECURE_HTTP=false

# Password for the bundled Postgres. Use a long random value.
POSTGRES_PASSWORD=

LOG_LEVEL=info
